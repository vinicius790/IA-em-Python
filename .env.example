# Copie para `.env` (ignorado pelo git) e ajuste. Todas as variáveis são opcionais em development.

# development = API aberta se API_KEY estiver vazia. Qualquer outro valor exige API_KEY.
ENVIRONMENT=development
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Opcional: assina os registros do registry (HMAC). Sem ela só o checksum é conferido.
ARTIFACT_SIGNING_KEY=

DEBUG=false
DATABASE_URL=sqlite:///./data/iris.db
MODEL_DIR=models
ARTIFACT_DIR=artifacts
DATA_DIR=data
CORS_ORIGINS=http://localhost:8000
DEFAULT_MODEL=xgboost
RANDOM_STATE=42

MAX_BATCH_SIZE=500
MAX_REQUEST_BYTES=2000000
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# Vazio = experimentos só na tabela experiment_runs. Com MLflow instalado, envia também para lá.
MLFLOW_TRACKING_URI=

# Monitoramento e release gate
DRIFT_PSI_WARNING=0.10
DRIFT_PSI_THRESHOLD=0.25
GATE_MIN_ACCURACY=0.90
GATE_MIN_F1=0.90
GATE_MAX_LATENCY_MS=100
SLO_P95_LATENCY_MS=100
SLO_MIN_MEAN_CONFIDENCE=0.70

# Só para o docker-compose.yml
GRAFANA_ADMIN_PASSWORD=
